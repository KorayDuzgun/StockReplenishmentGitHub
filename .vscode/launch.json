{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug API",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-api",
            "program": "${workspaceFolder}/src/StockReplenishment.Api/bin/Debug/net10.0/StockReplenishment.Api.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/StockReplenishment.Api",
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5283"
            }
        },
        {
            "name": "Debug Web",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-web",
            "program": "${workspaceFolder}/src/StockReplenishment.Web/bin/Debug/net10.0/StockReplenishment.Web.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/StockReplenishment.Web",
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5156"
            }
        },
        {
            "name": "Attach to Process",
            "type": "coreclr",
            "request": "attach"
        }
    ],
    "compounds": [
        {
            "name": "Debug API + Web",
            "configurations": [
                "Debug API",
                "Debug Web"
            ],
            "stopAll": true
        }
    ]
}
